<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/>
    </parent>

    <groupId>se.edugrade.java25</groupId>
    <artifactId>restaurant-api</artifactId>
    <version>1.0-SNAPSHOT</version>
    <name>restaurant-api</name>
    <description>An API for restaurant bookings</description>

    <properties>
        <java.version>25</java.version>
        <maven.compiler.source>25</maven.compiler.source>
        <maven.compiler.target>25</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <rest-assured.version>5.5.7</rest-assured.version>

        <!-- RestAssured runs its DSL on Groovy and declares the range [4.0,5.0).
             Spring Boot 4.1.0 manages Groovy at 5.0.6, which RestAssured cannot load:
             every GET fails with a NullPointerException deep inside Groovy's metaclass
             code. Overriding the property here pins Groovy back into the supported
             range. Remove the override once RestAssured supports Groovy 5. -->
        <groovy.version>4.0.22</groovy.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Spring Boot 4.1.0 does NOT manage RestAssured versions, so we import
                 RestAssured's own BOM. That keeps rest-assured and json-schema-validator
                 on the same version without repeating it on every dependency. -->
            <dependency>
                <groupId>io.rest-assured</groupId>
                <artifactId>rest-assured-bom</artifactId>
                <version>${rest-assured.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- Spring MVC and an embedded Tomcat. Everything else - JPA, H2,
             validation, HATEOAS, springdoc, security - you add yourself as
             each part of the assignment needs it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-h2console</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springdoc</groupId>
            <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
            <version>3.1.0</version>
        </dependency>

        <!-- A second message converter, so content negotiation has a real
             choice to make. Without this the server can only produce JSON and
             every Accept header ends in the same place.
             Spring Boot 4 ships Jackson 3: group id is tools.jackson, not
             com.fasterxml. -->
        <dependency>
            <groupId>tools.jackson.dataformat</groupId>
            <artifactId>jackson-dataformat-xml</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jpa-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
        <!-- The given/when/then DSL. Test scope only: it never ships. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>rest-assured</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- matchesJsonSchemaInClasspath. Separate artifact from rest-assured core. -->
        <dependency>
            <groupId>io.rest-assured</groupId>
            <artifactId>json-schema-validator</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- EntityModel, CollectionModel, PagedModel, WebMvcLinkBuilder and the
     HAL renderer. Adding it changes the default JSON media type for
     representation models to application/hal+json - see
     spring.hateoas.use-hal-as-default-json-media-type in
     application.properties. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-hateoas</artifactId>
        </dependency>

        <!-- Spring Security is here for ONE reason: CORS ordering only becomes
     visible when there is a filter chain to order things in. Course 05
     chapter 25 owns SecurityFilterChain; this chapter only shows where
     the CORS filter sits inside it. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security</artifactId>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-oauth2-resource-server</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
